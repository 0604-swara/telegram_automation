# Copy to .env and fill in real values. Never commit .env.

TELEGRAM_BOT_TOKEN=
SOURCE_CHANNEL_ID=
DESTINATION_CHANNEL_ID=
DB_PATH=telegram_queue.db

# Publishing schedule
PUBLISH_INTERVAL_SECONDS=300
PUBLISH_START_TIME=08:00
PUBLISH_END_TIME=00:00

# Optional tuning
# EMPTY_QUEUE_CHECK_SECONDS=30
# ALBUM_WAIT_SECONDS=15
# STALE_CLAIM_SECONDS=900
# SCHEDULER_LOCK_FILE=scheduler.lock
# LISTENER_LOCK_FILE=listener.lock
# PROCESS_MANAGER_LOCK_FILE=process_manager.lock
# LOG_TO_STDOUT=0
